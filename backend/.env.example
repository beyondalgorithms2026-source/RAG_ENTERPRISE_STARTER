# ── Database ──────────────────────────────────────────
# Project-isolated local Postgres default for rag_enterprise_starter
DATABASE_URL=postgresql://rag_enterprise_starter:rag_enterprise_starter_dev_pass@localhost:55432/rag_enterprise_starter

# ── Embedding ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# ── LLM ───────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-v3.1:671b-cloud
LLM_TIMEOUT_S=60
LLM_API_KEY=

# ── Retrieval ─────────────────────────────────────────
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_INITIAL=30
HYBRID_ALPHA=0.65
VECTOR_CANDIDATES=30
KEYWORD_CANDIDATES=30

# ── Enrichment (all disabled by default) ──────────────
ENABLE_GRAPH=false
ENABLE_TEMPORAL=false
ENABLE_ONTOLOGY=false
EXTRACT_ENTITIES=false
EXTRACT_RELATIONS=false
EXTRACT_TEMPORAL_METADATA=false
BUILD_GRAPH_ON_INGEST=false

# ── Query-time ────────────────────────────────────────
# Conservative but enabled by default:
# - lazy enrichment only runs for source-scoped `full` requests when prerequisites are satisfied
# - router only applies when no explicit mode is provided
ALLOW_LAZY_ENRICHMENT=true
TEMPORAL_RERANK_ENABLED=false
USE_QUERY_ROUTER=true

# ── Builder / Debug ──────────────────────────────────
ENABLE_COMPARISON_VIEW=true
ENABLE_RETRIEVAL_TRACE=true
ENABLE_GRAPH_EXPLAINABILITY=true

# ── Database ──────────────────────────────────────────
# Project-isolated local Postgres default for rag_enterprise_starter
DATABASE_URL=postgresql://rag_enterprise_starter:rag_enterprise_starter_dev_pass@localhost:55432/rag_enterprise_starter

# ── Embedding ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# ── LLM ───────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-v3.1:671b-cloud
LLM_TIMEOUT_S=60
LLM_API_KEY=

# ── Retrieval ─────────────────────────────────────────
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_INITIAL=30
HYBRID_ALPHA=0.65
VECTOR_CANDIDATES=30
KEYWORD_CANDIDATES=30

# ── Enrichment (all disabled by default) ──────────────
ENABLE_GRAPH=false
ENABLE_TEMPORAL=false
ENABLE_ONTOLOGY=false
EXTRACT_ENTITIES=false
EXTRACT_RELATIONS=false
EXTRACT_TEMPORAL_METADATA=false
BUILD_GRAPH_ON_INGEST=false

# ── Query-time ────────────────────────────────────────
# Conservative but enabled by default:
# - lazy enrichment only runs for source-scoped `full` requests when prerequisites are satisfied
# - router only applies when no explicit mode is provided
ALLOW_LAZY_ENRICHMENT=true
TEMPORAL_RERANK_ENABLED=false
USE_QUERY_ROUTER=true

# ── Builder / Debug ──────────────────────────────────
ENABLE_COMPARISON_VIEW=true
ENABLE_RETRIEVAL_TRACE=true
ENABLE_GRAPH_EXPLAINABILITY=true

# ── Security posture ─────────────────────────────────
# APP_ENV: local/dev/staging/prod
# AUTH_MODE:
# - none: trusted research mode; search/ask only, no admin, upload disabled unless explicitly allowed
# - dev: local learning mode with built-in test users; blocked outside local/dev
# - password: reserved for small-enterprise login implementation
# - oidc: enterprise SSO
APP_ENV=local
AUTH_ENABLED=false
AUTH_MODE=none
AUTH_NONE_ALLOW_UPLOAD=false
AUTH_STATE_SIGNING_SECRET=replace-with-strong-random-secret
DEV_LOCAL_JWT_SECRET=replace-with-strong-random-secret

# ── Abuse controls ───────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_ADMIN_EXPENSIVE_PER_MINUTE=6
